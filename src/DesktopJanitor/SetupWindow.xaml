<Window x:Class="DesktopJanitor.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Janitor Setup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Width="600"
        SizeToContent="Height"
        FontFamily="Segoe UI"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="12">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" />
        </Grid.Effect>
        <Border Background="{StaticResource Paper}"
                BorderBrush="{StaticResource Ink}"
                BorderThickness="2.5"
                CornerRadius="16"
                Padding="20,16,14,18"
                MouseLeftButtonDown="OnDrag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="176" Height="168" Margin="0,6,18,0" VerticalAlignment="Top"
                        CornerRadius="12" Background="{StaticResource Track}">
                    <Image x:Name="Sprite" Width="176" Height="128" VerticalAlignment="Bottom" Margin="0,0,0,10"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                                Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close"
                                Click="OnCloseClick" />
                        <TextBlock x:Name="Heading" Margin="0,4,6,0" FontSize="20" FontWeight="Bold"
                                   TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                    </DockPanel>
                    <TextBlock x:Name="Body" Margin="0,8,12,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{StaticResource Ink}" />

                    <StackPanel x:Name="Options" Margin="0,14,0,0">
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start me when you sign in to Windows"
                                  Margin="0,0,0,7" Foreground="{StaticResource Ink}" Cursor="Hand" />
                        <CheckBox x:Name="DesktopShortcutBox" Content="Put a shortcut on the desktop"
                                  Margin="0,0,0,7" Foreground="{StaticResource Ink}" Cursor="Hand" />
                        <CheckBox x:Name="RemoveSettingsBox" Content="Also delete my settings and log"
                                  Margin="0,0,0,7" Foreground="{StaticResource Ink}" Cursor="Hand" />
                    </StackPanel>

                    <TextBlock x:Name="Status" Margin="0,10,12,0" TextWrapping="Wrap" FontStyle="Italic"
                               Foreground="{StaticResource InkSoft}" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,6,0">
                        <Button x:Name="SecondaryAction" Style="{StaticResource SecondaryButton}" Click="OnSecondaryClick" />
                        <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" Click="OnPrimaryClick" />
                    </StackPanel>

                    <TextBlock x:Name="Footnote" Margin="0,14,12,0" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource InkSoft}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
