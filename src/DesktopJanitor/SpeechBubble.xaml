<Window x:Class="DesktopJanitor.SpeechBubble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Janitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        FontSize="12.5"
        TextOptions.TextFormattingMode="Display">
    <!-- Colours and button styles live in App.xaml (shared with the memory list). -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" />
        </Grid.Effect>

        <Border Background="{StaticResource Paper}"
                BorderBrush="{StaticResource Ink}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="12,9,12,10"
                MaxWidth="400">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="BodyText" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                <StackPanel x:Name="ButtonRow" Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- Open path: the fill hides the border under the tail, the stroke draws its two sides. -->
        <Path x:Name="Tail"
              Grid.Row="1"
              HorizontalAlignment="Left"
              Margin="24,-2.5,0,0"
              Data="M0,0 L9,11 L18,0"
              Fill="{StaticResource Paper}"
              Stroke="{StaticResource Ink}"
              StrokeThickness="2" />
    </Grid>
</Window>
